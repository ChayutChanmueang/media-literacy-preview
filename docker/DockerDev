# Media Literacy — Next.js Multi-stage Dockerfile (dev image)
# Cloned from docker/Dockerfile; production `next start` with Dev Hub baked in.
#
# ใช้ next build + next start เหมือน production (พอร์ต 8080) ไม่ใช้ `next dev`
# เพราะ Next.js 16 บล็อก Host ที่ไม่ใช่ localhost ทำให้เข้าเว็บผ่าน IP/โดเมนเครื่องแม่ข่ายไม่ได้
#
# Build จาก root ของ repo:
#   docker build -f docker/DockerDev -t media-literacy:dev .
#   docker run --rm -p 8080:8080 -e DATABASE_URL="..." media-literacy:dev

FROM node:24-alpine AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm install --legacy-peer-deps

FROM node:24-alpine AS build
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
# NEXT_PUBLIC_* ฝังตอน compile — ต้องตั้งตอน build ถึงจะเปิดปุ่ม skip / /dev/games ฝั่ง client
ENV ENABLE_DEV_HUB=true
ENV NEXT_PUBLIC_ENABLE_DEV_HUB=true
# API route modules validate DATABASE_URL while Next.js collects route metadata.
# This build-only placeholder creates no connection and is not copied to runner.
ARG BUILD_DATABASE_URL=postgresql://build:build@localhost:5432/build
ENV DATABASE_URL=${BUILD_DATABASE_URL}
RUN npm run build

FROM node:24-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8080
ENV HOSTNAME=0.0.0.0
ENV NEXT_TELEMETRY_DISABLED=1
ENV ENABLE_DEV_HUB=true
ENV NEXT_PUBLIC_ENABLE_DEV_HUB=true

COPY --from=build /app/package.json ./package.json
COPY --from=build /app/package-lock.json ./package-lock.json
COPY --from=build /app/public ./public
COPY --from=build /app/.next ./.next
COPY --from=build /app/node_modules ./node_modules

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s CMD wget --no-verbose --tries=1 --spider http://localhost:8080/ || exit 1

CMD ["npm", "run", "start"]
