{
  "$schema": "internal/media-literacy-design-tokens",
  "meta": {
    "collected": "2026-07-15",
    "sources": {
      "brand_logo": "docs/wiki/design/_logo.jpg",
      "greentravel_ui": "docs/wiki/design/_idea-1.jpg",
      "website_index_css": "src/index.css"
    }
  },
  "brand": {
    "concept": {
      "shapes": ["heart", "sprout leaves", "mountain", "wave"],
      "regionalFocus": ["Chiang Mai", "Nan", "Phrae"],
      "primaryAudience": "Seniors / Community"
    },
    "colors": {
      "chiangmaiPurple": { "hex": "#7B2CBF", "meaning": "wisdom, spiritual, reliable, elderly man" },
      "phraeOrange": { "hex": "#E65100", "meaning": "warmth, family, energy, children" },
      "nanGreen": { "hex": "#2E7D32", "meaning": "nature, peaceful, community, elderly woman" },
      "tealDefault": { "hex": "#0D9488", "meaning": "health, balance, modern default" },
      "waveBlue": { "hex": "#0288D1", "meaning": "water waves, geography, secondary decoration" },
      "goldPagoda": { "hex": "#FFB300", "meaning": "temple, reward coins, success alert" }
    },
    "font": { "defaultThai": "Noto Looped Thai", "source": "Figma typography — docs/wiki/design/07-typography.md" }
  },
  "website": {
    "colors": {
      "light": {
        "primary": "#0D9488",
        "primaryHover": "#0F766E",
        "primaryLight": "#CCFBF1",
        "primaryDark": "#115E59",
        "bgApp": "#F8FAFC",
        "bgCard": "#FFFFFF",
        "textPrimary": "#0F172A",
        "textSecondary": "#475569",
        "border": "#E2E8F0",
        "success": "#16A34A",
        "error": "#DC2626"
      },
      "dark": {
        "primary": "#0D9488",
        "primaryHover": "#0F766E",
        "primaryLight": "#115E59",
        "primaryDark": "#CCFBF1",
        "bgApp": "#0F172A",
        "bgCard": "#1E293B",
        "textPrimary": "#F8FAFC",
        "textSecondary": "#CBD5E1",
        "border": "#334155",
        "success": "#16A34A",
        "error": "#DC2626"
      }
    },
    "typography": {
      "source": "Figma Scammer Game Prototype node 1055:615 — docs/wiki/design/07-typography.md",
      "fontFamilies": {
        "base": ["Noto Sans Thai Looped", "system-ui", "sans-serif"],
        "stagePopupOnly": ["Mali"]
      },
      "letterSpacing": 0,
      "styles": {
        "display": { "size": 40, "lineHeight": 48, "weight": 700 },
        "h1": { "size": 32, "lineHeight": 40, "weight": 700 },
        "h2": { "size": 28, "lineHeight": 36, "weight": 700 },
        "h3": { "size": 24, "lineHeight": 32, "weight": 600 },
        "bodyLarge": { "size": 22, "lineHeight": 32, "weight": 400 },
        "body": { "size": 20, "lineHeight": 30, "weight": 400 },
        "button": { "size": 20, "lineHeight": 30, "weight": 600 },
        "caption": { "size": 18, "lineHeight": 26, "weight": 400 },
        "small": { "size": 12, "lineHeight": 16, "weight": 400 }
      }
    },
    "layout": {
      "maxWidthMobile": 480,
      "paddingScreen": 24,
      "paddingCard": 24,
      "radiusLg": 16,
      "radiusXl": 24,
      "radiusPill": 9999
    },
    "components": {
      "button": {
        "minHeight": 56,
        "padding": "12px 24px",
        "borderRadius": "var(--radius-lg)"
      },
      "premiumCard": {
        "borderRadius": "var(--radius-xl)",
        "borderLeftWidth": 6,
        "boxShadow": "0 20px 25px -5px rgba(var(--primary-rgb), 0.08)"
      },
      "locationBox": {
        "minHeight": 48,
        "borderRadius": "var(--radius-lg)"
      },
      "scoreProgressRing": {
        "strokeWidth": "10-12px",
        "trackColor": "var(--primary-light)",
        "labelFont": "Noto Looped Thai",
        "labelSize": "36px+"
      },
      "statTileGrid": {
        "columns": "2-3",
        "gap": 12,
        "borderRadius": "var(--radius-lg)"
      },
      "bottomTabNav": {
        "height": "64-72px",
        "position": "fixed",
        "primaryActionStyle": "elevated circular button"
      }
    }
  }
}
