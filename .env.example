# ===================================================================
# ตัวอย่างค่า environment — คัดลอกเป็น .env.local แล้วเติมค่าจริง
# ⚠️ ห้ามใส่ค่า secret จริงในไฟล์นี้ (ไฟล์นี้ถูก commit ลง git)
# ===================================================================

# Supabase Connection URL (IPv4 Connection Pooler - Port 6543)
DATABASE_URL="postgres://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@YOUR-POOLER-HOST:6543/postgres?pgbouncer=true"

# Next.js client-side configuration
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-publishable-anon-key"

# Server-side only (อย่า expose ฝั่ง client) — ใช้กับ getSupabaseServerClient()
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Docker & Portainer Deployment Options
DOCKERHUB_IMAGE="naplabstudio/media-literacy:latest"
HOST_PORT="10980"

# โหมดของแอปสำหรับเว็บนี้ (อ่านฝั่ง server ตอน runtime — ตั้งแล้ว restart container ไม่ต้อง rebuild)
#   normal   = ผู้เล่นเลือกโหมดเนื้อเรื่อง/โหมดอิสระได้ ไม่มีแบบทดสอบก่อน/หลังเรียน (ค่าเริ่มต้น)
#   research = โหมดวิจัย มีแบบทดสอบก่อน/หลังเรียน (pre-post test) และเข้าสายเนื้อเรื่องอัตโนมัติ
APP_MODE=normal

# หน้าดึงข้อมูลสำหรับเจ้าหน้าที่ /admin/data-export (docs/software/12-data-export-page.md)
# Supabase Auth ของ "เซิร์ฟเวอร์เดียวกับเว็บนี้" — อ่านฝั่ง server ตอน runtime (ไม่ใช่ NEXT_PUBLIC_ เพราะ image เดียวใช้ 2 เครื่อง)
# SUPABASE_URL = URL ที่ container เรียกได้ (เบราว์เซอร์ไม่ต้องเข้าถึง), SUPABASE_PUBLISHABLE_KEY = publishable key หรือ anon key
# ไม่ตั้ง 2 ตัวนี้ = ปิดหน้า /admin (ตอบ 404)
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
# true = ดึงจาก DATABASE_URL ในโปรเซส Next (ใช้ตอน dev ที่ยังไม่รัน Edge Function)
# ไม่ตั้ง หรือไม่ใช่ true = เรียก Edge Function ml_functions ซึ่งอ่านตารางที่มีอยู่แล้ว ไม่มีตารางเก็บรายงาน
DATA_EXPORT_DIRECT=false

# Dev Game Hub (US-03-R4) — หน้ารวมเกมสำหรับทดสอบที่ /dev/games
# เปิดใช้อัตโนมัติตอน `npm run dev` ส่วนบน production ตั้งเป็น true แล้ว restart container
# (อ่านฝั่ง server ตอน runtime — ไม่ต้อง rebuild Docker image)
ENABLE_DEV_HUB=false
# ชื่อเดิมยังรองรับ (Portainer ที่ตั้ง NEXT_PUBLIC_ENABLE_DEV_HUB=true ไว้แล้วใช้ต่อได้)
NEXT_PUBLIC_ENABLE_DEV_HUB=false

# Allowed Dev Origins สำหรับ HMR / WSL / Local network debugging (คั่นด้วย comma)
NEXT_ALLOWED_DEV_ORIGINS="172.23.64.1,localhost"

